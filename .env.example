#email config
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SENDER_EMAIL=noreply@example.com
SMTP_USE_STARTTLS=false
#DB and Tokens
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/fastapi_starter_db
JWT_SECRET_KEY=your-long-random-secret-here
COOKIE_SECURE=false
CSRF_SECRET_KEY=your-long-random-csrf-secret-here
# PostgreSQL container configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=fastapi_starter_db
# Seeded admin account
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME
ADMIN_FIRST_NAME=System
ADMIN_LAST_NAME=Admin
# Frontend
FRONTEND_ORIGIN=http://localhost:5173
FRONTEND_RESET_URL=http://localhost:5173/reset-password
#Storage
REDIS_URL=redis://localhost:6379/0